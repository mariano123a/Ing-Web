# Supabase Configuration
# Obtén estos valores desde tu proyecto en https://supabase.com/dashboard
# Project Settings > API

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (segura para usar en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (SOLO para uso en servidor, NUNCA expongas en el cliente)
# Esta key tiene permisos completos, úsala solo en el MCP server
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vercel (generado automáticamente)
VERCEL_OIDC_TOKEN=
